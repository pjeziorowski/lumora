# .swiftformat
--swiftversion 6.0
--indent 4
--maxwidth 140
--wraparguments before-first
--wrapcollections before-first
--self remove
--exclude Packages/*/.build,Packages/AstroCore/Sources/AstroCore/VSOP87Earth.swift,Packages/AstroCore/Sources/AstroCore/Moon.swift
--disable redundantReturn,wrapMultilineStatementBraces
