        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia"
          }
        }
      }
    },
    "Pick how distances and times are shown. You can change these in Settings.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak pokazywać odległości i godziny. Możesz to zmienić w Ustawieniach."
          }
        }
      }
    },
    "Plan the light": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj światło"
          }
        }
      }
    },
