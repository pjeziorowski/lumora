    "Sun": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce"
          }
        }
      }
    },
    "Sun & Moon AR": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce i Księżyc AR"
          }
        }
      }
    },
    "Sun, Moon and core directions on a map, with the time bar and panels.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierunki Słońca, Księżyca i centrum Galaktyki na mapie, z osią czasu i panelami."
          }
        }
      }
    },
    "Sun, Moon, Milky Way and next plan, on the Home and Lock Screen.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce, Księżyc, Droga Mleczna i najbliższy plan na ekranie głównym i blokady."
          }
        }
      }
    },
    "Sun, Moon, Milky Way, meteor showers, eclipses and photography calculators.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce, Księżyc, Droga Mleczna, roje meteorów, zaćmienia i kalkulatory fotograficzne."
          }
        }
      }
    },
    "The Moon's phase and its next rise or set.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Faza Księżyca i jego najbliższy wschód lub zachód."
          }
        }
      }
    },
    "Through the night": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu nocy"
          }
        }
      }
    },
    "Time lapse": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poklatkowy"
          }
        }
      }
    },
    "Times and directions are worked out for one place. Use where you are now, or choose any place from the place bar later.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny i kierunki są liczone dla jednego miejsca. Użyj bieżącej lokalizacji albo wybierz dowolne miejsce później z paska miejsca."
          }
        }
      }
    },
    "Times are always shown in the planned place's own time zone.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny są zawsze podawane w strefie czasowej planowanego miejsca."
          }
        }
      }
    },
    "To add a widget, touch and hold the Home Screen or Lock Screen, tap Edit, then Add Widgets, and choose Lumora. Widgets use the place selected here.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać widżet, przytrzymaj ekran główny lub ekran blokady, stuknij Edytuj, potem Dodaj widżety i wybierz Lumorę. Widżety używają wybranego tu miejsca."
          }
        }
      }
    },
    "Tonight": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś w nocy"
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia"
          }
        }
      }
    },
    "Units": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostki"
          }
        }
      }
    },
    "Units and time": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostki i czas"
          }
        }
      }
    },
    "Use my location": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj mojej lokalizacji"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja"
          }
        }
      }
    },
    "Visible here": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczne tutaj"
          }
        }
      }
    },
    "When the galactic core is up in a dark sky tonight.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy dziś centrum Galaktyki jest nad horyzontem na ciemnym niebie."
          }
        }
      }
    },
    "Widget": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widżet"
          }
        }
      }
    },
    "Widgets": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widżety"
          }
        }
      }
    },
    "Your location stays on this iPhone. Lumora has no account and sends nothing about you anywhere.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja lokalizacja zostaje na tym iPhonie. Lumora nie ma kont i nigdzie nie wysyła danych o Tobie."
          }
        }
      }
    },
    "Your next saved plan and the light it expects.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój najbliższy zapisany plan i oczekiwane światło."
          }
        }
      }
    },
    "Your place": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje miejsce"
          }
        }
      }
    },
