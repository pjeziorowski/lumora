      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planer"
          }
        }
      }
    },
    "Plans and favourite places, shareable as a file.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany i ulubione miejsca, do udostępnienia jako plik."
          }
        }
      }
    },
    "Plans and widgets": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany i widżety"
          }
        }
      }
    },
    "Save a moment from the Planner as a plan, with a reminder and a calendar event. Add widgets to see the light and your next plan at a glance.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz chwilę z Planera jako plan, z przypomnieniem i wydarzeniem w kalendarzu. Dodaj widżety, by od razu widzieć światło i najbliższy plan."
          }
        }
      }
    },
    "See the paths over the camera view where you stand.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz ścieżki na obrazie z aparatu tam, gdzie stoisz."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
